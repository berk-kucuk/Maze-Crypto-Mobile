<?xml version="1.0" encoding="utf-8"?>
<!-- Wallets: their total and up to five wallets (Ledger, Monero scan state). Hand-written. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
<LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_label" style="@style/WidgetText.Title"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/w_updated" style="@style/WidgetText.Dim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_total" style="@style/WidgetText.Big"
    android:layout_marginTop="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_empty" style="@style/WidgetText.Hint"
    android:visibility="gone"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />
<LinearLayout android:id="@+id/wl_row0"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_name0" style="@style/WidgetText.Sym.Small"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_sub0" style="@style/WidgetText.Dim"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_val0" style="@style/WidgetText.Price.Small"
    android:layout_marginStart="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<LinearLayout android:id="@+id/wl_row1"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_name1" style="@style/WidgetText.Sym.Small"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_sub1" style="@style/WidgetText.Dim"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_val1" style="@style/WidgetText.Price.Small"
    android:layout_marginStart="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<LinearLayout android:id="@+id/wl_row2"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_name2" style="@style/WidgetText.Sym.Small"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_sub2" style="@style/WidgetText.Dim"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_val2" style="@style/WidgetText.Price.Small"
    android:layout_marginStart="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<LinearLayout android:id="@+id/wl_row3"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_name3" style="@style/WidgetText.Sym.Small"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_sub3" style="@style/WidgetText.Dim"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_val3" style="@style/WidgetText.Price.Small"
    android:layout_marginStart="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<LinearLayout android:id="@+id/wl_row4"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/wl_name4" style="@style/WidgetText.Sym.Small"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
<TextView android:id="@+id/wl_sub4" style="@style/WidgetText.Dim"
    android:maxLines="1"
    android:ellipsize="end"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
<TextView android:id="@+id/wl_val4" style="@style/WidgetText.Price.Small"
    android:layout_marginStart="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
</LinearLayout>
