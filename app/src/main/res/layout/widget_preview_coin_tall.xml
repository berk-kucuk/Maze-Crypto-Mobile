<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_widget_layouts.py — edit that, not this file.

  One coin, 2x2 (or a tall 2x1 / 4x2): price, change, 7-day sparkline.
  Height: 10 + 17.5 + 4 + 19.9 + 6 + 16 spark + 5 + 11.7 + 10 = 100.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
<LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/c_sym" style="@style/WidgetText.Sym.Large"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="BTC" />
<TextView android:id="@+id/c_chg" style="@style/WidgetText.Change.Small"
    android:textColor="@color/w_up"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="+2.41%" />
</LinearLayout>
<TextView android:id="@+id/c_price" style="@style/WidgetText.Big"
    android:layout_marginTop="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="$112,480" />
<ImageView android:id="@+id/c_spark"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_marginTop="6dp"
    android:minHeight="16dp"
    android:scaleType="fitXY"
    android:contentDescription="@null"
    android:src="@drawable/widget_preview_spark" />
<LinearLayout
    android:orientation="horizontal"
    android:layout_marginTop="5dp"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/c_name" style="@style/WidgetText.Dim"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="Bitcoin" />
<TextView android:id="@+id/w_updated" style="@style/WidgetText.Dim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="14:05" />
</LinearLayout>
</LinearLayout>
