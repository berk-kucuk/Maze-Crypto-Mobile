<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
<LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/pl_label" style="@style/WidgetText.Title"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="Buying plan" />
<TextView android:id="@+id/pl_state" style="@style/WidgetText.Change.Small"
    android:textColor="@color/w_accent"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Due now" />
</LinearLayout>
<TextView android:id="@+id/pl_amount" style="@style/WidgetText.Big"
    android:layout_marginTop="3dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="₺4,500" />
<TextView android:id="@+id/pl_when" style="@style/WidgetText.Dim"
    android:layout_marginTop="3dp"
    android:visibility="visible"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Period 4 of 12 · today" />
<ImageView android:id="@+id/pl_bar"
    android:layout_width="match_parent"
    android:layout_height="5dp"
    android:layout_marginTop="8dp"
    android:scaleType="fitXY"
    android:visibility="visible"
    android:contentDescription="@null"
    android:src="@drawable/widget_preview_progress" />
<TextView android:id="@+id/pl_items" style="@style/WidgetText.Dim"
    android:layout_width="match_parent"
    android:layout_marginTop="6dp"
    android:visibility="visible"
    android:layout_height="wrap_content"
    android:text="BTC ₺2,250 · ETH ₺1,350 · SOL ₺900" />
</LinearLayout>
