<!--
  GENERATED by tools/gen_widget_layouts.py — edit that, not this file.

  Portfolio, 2 cells x 1 row: value and today's change. With a little more
  height (a portrait 2x1) a profit/loss line appears under the value.
  Height: 8 + 12.9 + 3 + 19.9 + 8 = 51.8 -> 50; with the line + 5 + 12.9 = 70.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
<LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/p_label" style="@style/WidgetText.Title"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="Portfolio" />
<TextView android:id="@+id/p_day" style="@style/WidgetText.Change.Small"
    android:textColor="@color/w_up"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="+1.84%" />
</LinearLayout>
<TextView android:id="@+id/p_value" style="@style/WidgetText.Big"
    android:layout_marginTop="3dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="$48,210" />
<TextView android:id="@+id/p_sub" style="@style/WidgetText.Change.Small"
    android:layout_marginTop="5dp"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />
</LinearLayout>
