<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_widget_layouts.py — edit that, not this file.

  Portfolio, 2x2 or 4x2: value, today, profit/loss, allocation bar and the largest holdings.
  Height: 10 + 12.9 + 4 + 19.9 + 6 + 11.7 + 2 + 15.2 + 8 + 6 + 5 + 11.7 + 10 = 123 -> 120.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@drawable/widget_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
<LinearLayout
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<TextView android:id="@+id/p_label" style="@style/WidgetText.Title"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content"
    android:text="Portfolio" />
<TextView android:id="@+id/w_updated" style="@style/WidgetText.Dim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="14:05" />
</LinearLayout>
<TextView android:id="@+id/p_value" style="@style/WidgetText.Big"
    android:layout_marginTop="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="$48,210" />
<LinearLayout
    android:orientation="horizontal"
    android:layout_marginTop="6dp"
    android:baselineAligned="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="wrap_content">
<TextView android:id="@+id/p_day_label" style="@style/WidgetText.Dim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="24h" />
<TextView android:id="@+id/p_day" style="@style/WidgetText.Price"
    android:layout_marginTop="2dp"
    android:textColor="@color/w_up"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="+1.84%" />
</LinearLayout>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_marginStart="8dp"
    android:layout_height="wrap_content">
<TextView android:id="@+id/p_pnl_label" style="@style/WidgetText.Dim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Profit/loss" />
<TextView android:id="@+id/p_pnl" style="@style/WidgetText.Price"
    android:layout_marginTop="2dp"
    android:textColor="@color/w_up"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="+14.5%" />
</LinearLayout>
</LinearLayout>
<ImageView android:id="@+id/p_bar"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="8dp"
    android:scaleType="fitXY"
    android:contentDescription="@null"
    android:src="@drawable/widget_preview_bar" />
<TextView android:id="@+id/p_legend" style="@style/WidgetText.Dim"
    android:layout_width="match_parent"
    android:layout_marginTop="5dp"
    android:layout_height="wrap_content"
    android:text="BTC 52% · ETH 21% · SOL 9%" />
</LinearLayout>
