<?xml version="1.0" encoding="utf-8"?>
<!-- The card: solid OLED black — fully opaque, the wallpaper never shows
     through — with a hairline rim so it still has an edge on a black wallpaper. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF000000" />
    <stroke android:width="1dp" android:color="#FF1E1E23" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
