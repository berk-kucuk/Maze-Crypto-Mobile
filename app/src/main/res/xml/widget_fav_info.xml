<?xml version="1.0" encoding="utf-8"?>
<!--
  Placed at 4x2; the sizes follow Android's rule for n cells, 70 x n - 30 dp.
  The widget adapts to whatever it is then given — rotated, resized, or on a
  grid with taller cells — by picking among layouts measured for each range
  (WidgetLayouts.kt). That is why it can shrink to one row or two columns.

  updatePeriodMillis is 0: the app's own refresh job redraws it (every 15
  minutes by default, Settings → Widgets), plus a tap on its refresh icon.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_fav_list"
    android:previewLayout="@layout/widget_preview_fav_list"
    android:description="@string/widget_fav_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
