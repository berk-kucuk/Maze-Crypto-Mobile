<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Public market data only. No accounts, no analytics, no ads. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Background refresh waits for a network (JobInfo network constraint needs it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Alert notifications (asked for when the first alert is turned on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the periodic widget refresh survive a reboot (JobInfo.setPersisted). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ledger: USB (OTG) and Bluetooth LE. Optional hardware; asked for only on the Ledger screen.
         Bluetooth is used to talk to a Ledger, never to find where the phone is. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".MazeApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MazeCrypto">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.CoinWidgetConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver android:name=".widget.FavoritesWidget" android:exported="true" android:label="@string/widget_fav_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_fav_info" />
        </receiver>

        <receiver android:name=".widget.CoinWidget" android:exported="true" android:label="@string/widget_coin_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_coin_info" />
        </receiver>

        <receiver android:name=".widget.PortfolioWidget" android:exported="true" android:label="@string/widget_pf_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_pf_info" />
        </receiver>

        <receiver android:name=".widget.GridWidget" android:exported="true" android:label="@string/widget_grid_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_grid_info" />
        </receiver>

        <receiver android:name=".widget.MoversWidget" android:exported="true" android:label="@string/widget_movers_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_movers_info" />
        </receiver>

        <receiver android:name=".widget.HoldingsWidget" android:exported="true" android:label="@string/widget_hold_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_hold_info" />
        </receiver>

        <receiver android:name=".widget.PlanWidget" android:exported="true" android:label="@string/widget_plan_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_plan_info" />
        </receiver>

        <receiver android:name=".widget.TrendWidget" android:exported="true" android:label="@string/widget_trend_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_trend_info" />
        </receiver>

        <receiver android:name=".widget.WalletsWidget" android:exported="true" android:label="@string/widget_wallets_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_wallets_info" />
        </receiver>

        <receiver android:name=".widget.WidgetRefreshReceiver" android:exported="false" />

        <service
            android:name=".work.RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
